<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compile DefocusKernel from the plugin source and check it outside the game.

    From tests/DefocusKernelCheck, run dotnet run -c Release.

    Exit code 0 means every check passed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\DefocusKernel.cs" Link="DefocusKernel.cs" />
  </ItemGroup>
</Project>
